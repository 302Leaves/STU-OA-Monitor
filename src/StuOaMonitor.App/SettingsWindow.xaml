<Window x:Class="StuOaMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Width="360">
        <TextBlock Text="爬取最早日期（YYYY-MM-DD）："/>
        <TextBox x:Name="DateInput" Margin="0,6,0,0"/>
        <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="#777"/>
        <TextBlock Margin="0,4,0,0" Foreground="#777" TextWrapping="Wrap"
                   Text="提示：扩大日期范围后，此前未记录的历史条目会作为新通知提示一次。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Width="80" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="取消" Width="80" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>